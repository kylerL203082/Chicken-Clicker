function formatMoney(number){

    if(number >= 1000000)
        return "$" + (number / 1000000).toFixed(2) + "M";

    if(number >= 1000)
        return "$" + (number / 1000).toFixed(2) + "K";

    return "$" + number.toFixed(2);

}


function formatNumber(number){

    if(number >= 1000000)
        return (number / 1000000).toFixed(2) + "M";

    if(number >= 1000)
        return (number / 1000).toFixed(2) + "K";

    return Math.floor(number).toLocaleString();

}


function hasUpgrade(id){

    return !!state.upgrades[id];

}


function getProductionMultiplier(){

    let mult = 1;

    if(hasUpgrade("feed"))
        mult *= 1.15;

    if(hasUpgrade("nest"))
        mult *= 1.20;

    if(hasUpgrade("breed"))
        mult *= 1.30;

    if(hasUpgrade("precision"))
        mult *= 1.40;

    if(hasUpgrade("golden"))
        mult *= 2;

    if(hasUpgrade("manager"))
        mult *= 1.25;

    return mult;

}


function getEggsPerSecond(){

    const BASE_SECONDS_PER_EGG = 12;

    return (
        state.chickens /
        BASE_SECONDS_PER_EGG
    ) * getProductionMultiplier();

}


function getPublicInterest(){

    const minPrice = .01;

    const maxPrice = .99;

    let normalized =
        (state.eggPrice - minPrice) /
        (maxPrice - minPrice);

    normalized = Math.max(
        0,
        Math.min(1,normalized)
    );


    let penaltyStrength = .92;

    if(hasUpgrade("brand"))
        penaltyStrength = .72;


    let interest =
        1 -
        penaltyStrength *
        Math.pow(normalized,1.18);


    interest = Math.max(.08,interest);

    return interest;

}


function getMarketMultiplier(){

    let mult = 1;

    if(hasUpgrade("sign"))
        mult *= 1.20;

    if(hasUpgrade("delivery"))
        mult *= 1.30;

    if(hasUpgrade("grocery"))
        mult *= 1.60;

    if(hasUpgrade("national"))
        mult *= 2;

    if(hasUpgrade("conveyor"))
        mult *= 1.25;

    if(hasUpgrade("manager"))
        mult *= 1.25;

    return mult;

}


function getBaseMarketCapacity(){

    return 1.25 + (state.farmLevel * .75);

}


function getSalesPerSecond(){

    return (
        getBaseMarketCapacity() *
        getMarketMultiplier() *
        getPublicInterest()
    );

}


function changePrice(value){

    state.eggPrice =
        Number(value) / 100;

    updateUI();

}


function canBuyUpgrade(id){

    const upgrade =
        UPGRADES[id];

    if(!upgrade)
        return false;

    if(hasUpgrade(id))
        return false;

    if(
        state.farmLevel <
        upgrade.level
    )
        return false;

    if(
        upgrade.requires &&
        !hasUpgrade(upgrade.requires)
    )
        return false;

    if(
        state.money <
        upgrade.cost
    )
        return false;

    return true;

}


function buyUpgrade(id){

    const upgrade =
        UPGRADES[id];

    if(!upgrade)
        return;


    if(hasUpgrade(id)){

        addLog(
            upgrade.name +
            " is already unlocked."
        );

        return;
    }


    if(
        state.farmLevel <
        upgrade.level
    ){

        addLog(
            "Farm Level " +
            upgrade.level +
            " is required for " +
            upgrade.name +
            "."
        );

        return;
    }


    if(
        upgrade.requires &&
        !hasUpgrade(upgrade.requires)
    ){

        addLog(
            "You must unlock " +
            UPGRADES[upgrade.requires].name +
            " first."
        );

        return;
    }


    if(
        state.money <
        upgrade.cost
    ){

        addLog(
            "You need " +
            formatMoney(upgrade.cost) +
            " to buy " +
            upgrade.name +
            "."
        );

        return;
    }


    state.money -=
        upgrade.cost;

    state.upgrades[id] =
        true;


    addLog(
        "Unlocked " +
        upgrade.name +
        "!"
    );


    updateUI();

    saveGame();

}


function getChicken(){

    const now =
        Date.now();

    const cooldown =
        900;


    if(
        now -
        state.lastChickenClick <
        cooldown
    )
        return;


    state.lastChickenClick =
        now;

    state.chickens += 1;

    state.lifetimeChickens += 1;

    updateUI();

}


function upgradeFarm(){

    if(
        state.farmLevel >=
        FARM_LEVELS.length
    )
        return;


    const next =
        FARM_LEVELS[state.farmLevel];


    if(
        state.chickens <
        next.chickens
    ){

        addLog(
            "You need at least " +
            next.chickens +
            " chickens to reach Level " +
            next.level +
            "."
        );

        return;
    }


    if(
        state.money <
        next.cost
    ){

        addLog(
            "You need " +
            formatMoney(next.cost) +
            " to upgrade the farm."
        );

        return;
    }


    state.money -=
        next.cost;

    state.farmLevel++;


    addLog(
        "Farm upgraded to Level " +
        state.farmLevel +
        " — " +
        FARM_LEVELS[
            state.farmLevel - 1
        ].name +
        "!"
    );


    updateUI();

    saveGame();

}


function addLog(message){

    const log =
        document.getElementById(
            "gameLog"
        );


    const div =
        document.createElement(
            "div"
        );


    div.className =
        "logEntry";


    div.textContent =
        new Date().toLocaleTimeString(
            [],
            {
                hour:"2-digit",
                minute:"2-digit",
                second:"2-digit"
            }
        ) +
        " — " +
        message;


    log.prepend(div);


    while(
        log.children.length >
        35
    ){

        log.removeChild(
            log.lastChild
        );

    }

}
function updateAutoChickens(){

    const now =
        Date.now();


    let amount =
        0;

    let interval =
        Infinity;


    if(
        hasUpgrade("robotics")
    ){

        amount = 3;

        interval = 10000;

    }
    else if(
        hasUpgrade("brooder")
    ){

        amount = 1;

        interval = 12000;

    }
    else if(
        hasUpgrade("incubator")
    ){

        amount = 1;

        interval = 30000;

    }


    if(
        amount === 0
    )
        return;


    const elapsed =
        now -
        state.lastAutoChicken;


    if(
        elapsed >= interval
    ){

        const batches =
            Math.floor(
                elapsed /
                interval
            );


        const gained =
            batches *
            amount;


        state.chickens +=
            gained;

        state.lifetimeChickens +=
            gained;


        state.lastAutoChicken +=
            batches *
            interval;


        addLog(
            "Automation raised " +
            gained +
            (
                gained === 1
                    ? " chicken."
                    : " chickens."
            )
        );

    }

}


function gameTick(){

    const now =
        Date.now();


    let dt =
        (
            now -
            state.lastUpdate
        ) /
        1000;


    dt =
        Math.min(
            dt,
            5
        );


    state.lastUpdate =
        now;


    /*
        EGG PRODUCTION
    */

    const produced =
        getEggsPerSecond() *
        dt;


    state.eggs +=
        produced;

    state.lifetimeEggs +=
        produced;


    /*
        AUTOMATIC SALES
    */

    const potentialSales =
        getSalesPerSecond() *
        dt;


    const sold =
        Math.min(
            state.eggs,
            potentialSales
        );


    const revenue =
        sold *
        state.eggPrice;


    state.eggs -=
        sold;

    state.money +=
        revenue;

    state.lifetimeMoney +=
        revenue;


    /*
        AUTO CHICKEN SYSTEM
    */

    updateAutoChickens();


    updateUI();

}


