<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Chicken Farm Empire</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:
        linear-gradient(rgba(9,17,15,.70),rgba(9,17,15,.88)),
        radial-gradient(circle at top,#314c32,#101a16 65%);
    color:#f3f0df;
    min-height:100vh;
}

button,input{
    font-family:inherit;
}

button{
    cursor:pointer;
}

.topbar{
    min-height:80px;
    background:#111918;
    border-bottom:2px solid #43564c;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    padding:12px 22px;
    position:sticky;
    top:0;
    z-index:100;
    box-shadow:0 4px 18px rgba(0,0,0,.4);
}

.leftTop{
    display:flex;
    align-items:center;
    gap:15px;
}

#getChickenBtn{
    border:2px solid #edc368;
    background:#7b5319;
    color:white;
    border-radius:8px;
    padding:14px 22px;
    font-weight:bold;
    font-size:17px;
    box-shadow:
        inset 0 0 12px rgba(255,211,115,.25),
        0 0 12px rgba(237,195,104,.15);
}

#getChickenBtn:hover{
    background:#986923;
}

#getChickenBtn:disabled{
    opacity:.5;
    cursor:not-allowed;
}

.logoArea{
    text-align:center;
}

.logoArea h1{
    margin:0;
    font-size:25px;
    letter-spacing:2px;
}

.logoArea small{
    color:#d5b469;
}

.topStats{
    display:flex;
    gap:24px;
    font-size:15px;
}

.statTop strong{
    display:block;
    font-size:18px;
    color:#f3ca72;
}

.game{
    max-width:1500px;
    margin:auto;
    padding:22px;
}

.dashboard{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:20px;
}

.card{
    background:rgba(16,25,23,.92);
    border:1px solid #45554d;
    border-radius:10px;
    padding:16px;
    box-shadow:0 5px 15px rgba(0,0,0,.28);
}

.statCard .title{
    text-transform:uppercase;
    letter-spacing:1px;
    color:#b9b9ae;
    font-size:12px;
}

.statCard .number{
    margin-top:6px;
    font-size:29px;
    font-weight:bold;
    color:#f2c76d;
}

.statCard .sub{
    margin-top:4px;
    color:#a8b2aa;
    font-size:13px;
}

.controlsRow{
    display:grid;
    grid-template-columns:1.25fr 1fr;
    gap:18px;
    margin-bottom:22px;
}

.pricePanel h2,
.levelPanel h2{
    margin-top:0;
    margin-bottom:12px;
}

.priceDisplay{
    font-size:37px;
    font-weight:bold;
    color:#7bd98e;
    margin:8px 0;
}

.priceSlider{
    width:100%;
    accent-color:#e1ae51;
}

.interestMeter,
.levelMeter{
    width:100%;
    height:16px;
    background:#26302d;
    border-radius:12px;
    overflow:hidden;
    border:1px solid #49584f;
}

#interestBar{
    height:100%;
    width:100%;
    background:linear-gradient(90deg,#68c56f,#e8cb58);
    transition:width .25s;
}

#levelBar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,#c5973f,#f0d57a);
}

.controlInfo{
    margin-top:11px;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:8px;
    color:#c0c6bf;
    font-size:14px;
}

.upgradeFarmBtn{
    width:100%;
    margin-top:14px;
    padding:12px;
    border-radius:7px;
    border:1px solid #e9c265;
    background:#6d4d1d;
    color:white;
    font-weight:bold;
    font-size:15px;
}

.upgradeFarmBtn:hover{
    background:#8c6324;
}

.upgradeFarmBtn:disabled{
    background:#303734;
    color:#777;
    border-color:#505753;
    cursor:not-allowed;
}

.sectionTitle{
    text-align:center;
    margin:32px 0 7px;
    font-size:27px;
    letter-spacing:2px;
}

.sectionSubtitle{
    text-align:center;
    color:#a5aea8;
    margin-bottom:18px;
}

.treeWrapper{
    width:100%;
    overflow-x:auto;
    padding-bottom:15px;
}

.tree{
    width:1160px;
    height:710px;
    margin:auto;
    position:relative;
    background:
        radial-gradient(circle at center,rgba(177,137,53,.13),transparent 28%),
        linear-gradient(90deg,rgba(29,87,47,.08),transparent 35%),
        linear-gradient(-90deg,rgba(82,73,151,.08),transparent 35%),
        #101817;
    border:1px solid #3d4b45;
    border-radius:13px;
    overflow:hidden;
}

.tree svg{
    position:absolute;
    width:100%;
    height:100%;
    inset:0;
    pointer-events:none;
}

.treeLine{
    stroke:#65726c;
    stroke-width:3;
    opacity:.48;
}

.treeLine.active{
    stroke:#e8c56d;
    opacity:1;
    filter:drop-shadow(0 0 4px rgba(232,197,109,.6));
}

.branchLabel{
    position:absolute;
    top:24px;
    font-weight:bold;
    letter-spacing:2px;
    font-size:16px;
    color:#c6c9c5;
}

.productionLabel{
    left:118px;
}

.marketingLabel{
    right:135px;
}

.automationLabel{
    left:50%;
    transform:translateX(-50%);
    top:640px;
}

.centerNode{
    width:120px;
    height:120px;
    border-radius:50%;
    position:absolute;
    left:520px;
    top:270px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    border:5px solid #b8974f;
    background:
        radial-gradient(circle,#55451f,#181e1b 70%);
    box-shadow:
        0 0 30px rgba(218,180,88,.28),
        inset 0 0 20px rgba(221,179,79,.15);
    z-index:3;
    font-weight:bold;
    color:#f6d784;
}

.node{
    position:absolute;
    width:92px;
    height:92px;
    border-radius:50%;
    background:#17201e;
    border:4px solid #65716c;
    color:#aeb6b1;
    z-index:5;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    font-size:11px;
    padding:6px;
    transition:.18s;
    user-select:none;
}

.node:hover{
    transform:scale(1.07);
}

.node .icon{
    font-size:22px;
    margin-bottom:3px;
}

.node .cost{
    font-size:10px;
    margin-top:3px;
    color:#d8b662;
}

.node.available{
    border-color:#e6c16a;
    color:white;
    box-shadow:0 0 15px rgba(230,193,106,.38);
}

.node.bought{
    border-color:#ffdc78;
    background:#40351b;
    color:#fff1bf;
    box-shadow:
        0 0 14px rgba(255,218,120,.55),
        inset 0 0 12px rgba(255,215,112,.18);
}

.node.locked{
    opacity:.42;
    filter:grayscale(.65);
}

.node.production.available{
    background:#193224;
}

.node.marketing.available{
    background:#29233e;
}

.node.automation.available{
    background:#27313e;
}

.tooltip{
    position:fixed;
    background:#080d0c;
    border:1px solid #d2ad5d;
    padding:12px;
    width:235px;
    pointer-events:none;
    opacity:0;
    z-index:999;
    border-radius:7px;
    font-size:13px;
    box-shadow:0 5px 20px rgba(0,0,0,.6);
}

.tooltip strong{
    color:#f2c76b;
}

.tooltip .toolDesc{
    color:#cbd0cc;
    margin-top:5px;
    line-height:1.35;
}

.tooltip .toolReq{
    color:#da9d65;
    margin-top:7px;
}

.bottomPanels{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
    margin-top:20px;
}

.log{
    height:160px;
    overflow:auto;
    background:#0c1211;
    border:1px solid #36413c;
    border-radius:7px;
    padding:10px;
    font-size:13px;
    color:#aeb6b1;
}

.logEntry{
    margin-bottom:5px;
    border-bottom:1px solid #202926;
    padding-bottom:5px;
}

.rules{
    line-height:1.6;
    color:#c4cac5;
}

.rules strong{
    color:#edc96f;
}

.saveButtons{
    display:flex;
    gap:9px;
    margin-top:13px;
}

.smallBtn{
    padding:9px 13px;
    border:1px solid #59645f;
    border-radius:6px;
    background:#252e2a;
    color:white;
}

.smallBtn:hover{
    background:#34413b;
}

.resetBtn{
    border-color:#814947;
    background:#442422;
}

@media(max-width:900px){

    .dashboard{
        grid-template-columns:repeat(2,1fr);
    }

    .controlsRow,
    .bottomPanels{
        grid-template-columns:1fr;
    }

    .topbar{
        flex-wrap:wrap;
    }

    .logoArea{
        order:-1;
        width:100%;
    }

    .topStats{
        gap:10px;
    }
}

</style>
</head>

<body>

<div class="topbar">

    <div class="leftTop">
        <button id="getChickenBtn" onclick="getChicken()">
            🐔 Get Chicken
        </button>

        <div>
            <div>
                Chickens:
                <strong id="topChickens">1</strong>
            </div>

            <small id="chickenCooldown">
                Ready
            </small>
        </div>
    </div>

    <div class="logoArea">
        <h1>🐔 CHICKEN FARM EMPIRE</h1>
        <small id="farmNameTop">Backyard Coop — Level 1</small>
    </div>

    <div class="topStats">

        <div class="statTop">
            <span>Money</span>
            <strong id="topMoney">$0.00</strong>
        </div>

        <div class="statTop">
            <span>Eggs</span>
            <strong id="topEggs">0</strong>
        </div>

    </div>

</div>


<div class="game">

    <div class="dashboard">

        <div class="card statCard">
            <div class="title">Chickens</div>
            <div class="number" id="chickenStat">1</div>
            <div class="sub">
                Producing eggs around the clock
            </div>
        </div>

        <div class="card statCard">
            <div class="title">Egg Inventory</div>
            <div class="number" id="eggStat">0</div>
            <div class="sub" id="eggRateText">
                0.08 eggs/sec
            </div>
        </div>

        <div class="card statCard">
            <div class="title">Money</div>
            <div class="number" id="moneyStat">$0.00</div>
            <div class="sub" id="incomeText">
                $0.00/sec
            </div>
        </div>

        <div class="card statCard">
            <div class="title">Public Interest</div>
            <div class="number" id="interestStat">100%</div>
            <div class="sub" id="salesRateText">
                Market demand
            </div>
        </div>

    </div>


    <div class="controlsRow">

        <div class="card pricePanel">

            <h2>🥚 Egg Market</h2>

            <div>
                Your Selling Price
            </div>

            <div class="priceDisplay" id="priceDisplay">
                $0.20
            </div>

            <input
                id="priceSlider"
                class="priceSlider"
                type="range"
                min="1"
                max="99"
                value="20"
                oninput="changePrice(this.value)"
            >

            <div style="display:flex;justify-content:space-between;font-size:12px;color:#929a95;">
                <span>$0.01</span>
                <span>$0.99</span>
            </div>

            <div style="margin-top:17px;">
                Public Interest
            </div>

            <div class="interestMeter">
                <div id="interestBar"></div>
            </div>

            <div class="controlInfo">

                <div>
                    Interest:
                    <strong id="interestText">100%</strong>
                </div>

                <div>
                    Eggs selling:
                    <strong id="marketSpeedText">0/sec</strong>
                </div>

                <div>
                    Egg production:
                    <strong id="productionText">0/sec</strong>
                </div>

                <div>
                    Revenue:
                    <strong id="revenueText">$0/sec</strong>
                </div>

            </div>

        </div>


        <div class="card levelPanel">

            <h2>🏡 Farm Level</h2>

            <div style="font-size:24px;font-weight:bold;color:#f2c86e;" id="levelName">
                Level 1 — Backyard Coop
            </div>

            <p id="levelDescription" style="color:#adb5af;">
                A tiny backyard operation with big ambitions.
            </p>

            <div class="levelMeter">
                <div id="levelBar"></div>
            </div>

            <div class="controlInfo">

                <div>
                    Required chickens:
                    <strong id="levelChickenReq">10</strong>
                </div>

                <div>
                    Upgrade cost:
                    <strong id="levelMoneyReq">$25</strong>
                </div>

            </div>

            <button
                class="upgradeFarmBtn"
                id="upgradeFarmBtn"
                onclick="upgradeFarm()"
            >
                Upgrade Farm
            </button>

        </div>

    </div>


    <h2 class="sectionTitle">
        FARM TALENT TREE
    </h2>

    <div class="sectionSubtitle">
        Buy upgrades as your farm grows. Connected upgrades must be unlocked in order.
    </div>


    <div class="treeWrapper">

        <div class="tree" id="upgradeTree">

            <div class="branchLabel productionLabel">
                PRODUCTION
            </div>

            <div class="branchLabel marketingLabel">
                MARKETING
            </div>

            <div class="branchLabel automationLabel">
                AUTOMATION
            </div>


            <svg viewBox="0 0 1160 710">

                <!-- PRODUCTION -->

                <line
                    id="line-center-feed"
                    class="treeLine"
                    x1="580" y1="330"
                    x2="420" y2="280"
                />

                <line
                    id="line-feed-nest"
                    class="treeLine"
                    x1="420" y1="280"
                    x2="300" y2="200"
                />

                <line
                    id="line-nest-breed"
                    class="treeLine"
                    x1="300" y1="200"
                    x2="175" y2="120"
                />

                <line
                    id="line-breed-precision"
                    class="treeLine"
                    x1="175" y1="120"
                    x2="145" y2="280"
                />

                <line
                    id="line-precision-golden"
                    class="treeLine"
                    x1="145" y1="280"
                    x2="250" y2="405"
                />


                <!-- MARKETING -->

                <line
                    id="line-center-sign"
                    class="treeLine"
                    x1="580" y1="330"
                    x2="735" y2="280"
                />

                <line
                    id="line-sign-delivery"
                    class="treeLine"
                    x1="735" y1="280"
                    x2="855" y2="200"
                />

                <line
                    id="line-delivery-brand"
                    class="treeLine"
                    x1="855" y1="200"
                    x2="985" y2="120"
                />

                <line
                    id="line-brand-grocery"
                    class="treeLine"
                    x1="985" y1="120"
                    x2="1010" y2="280"
                />

                <line
                    id="line-grocery-national"
                    class="treeLine"
                    x1="1010" y1="280"
                    x2="910" y2="405"
                />


                <!-- AUTOMATION -->

                <line
                    id="line-center-conveyor"
                    class="treeLine"
                    x1="580" y1="330"
                    x2="580" y2="465"
                />

                <line
                    id="line-conveyor-incubator"
                    class="treeLine"
                    x1="580" y1="465"
                    x2="470" y2="560"
                />

                <line
                    id="line-incubator-brooder"
                    class="treeLine"
                    x1="470" y1="560"
                    x2="580" y2="600"
                />

                <line
                    id="line-brooder-manager"
                    class="treeLine"
                    x1="580" y1="600"
                    x2="690" y2="560"
                />

                <line
                    id="line-manager-robotics"
                    class="treeLine"
                    x1="690" y1="560"
                    x2="800" y2="500"
                />

            </svg>


            <div class="centerNode">
                🐔<br>
                YOUR<br>
                FARM
            </div>


            <!-- Production -->

            <button
                class="node production"
                id="node-feed"
                style="left:374px;top:234px;"
                onclick="buyUpgrade('feed')"
            >
                <span class="icon">🌾</span>
                Better Feed
                <span class="cost">$35</span>
            </button>

            <button
                class="node production"
                id="node-nest"
                style="left:254px;top:154px;"
                onclick="buyUpgrade('nest')"
            >
                <span class="icon">🪺</span>
                Warm Nests
                <span class="cost">$120</span>
            </button>

            <button
                class="node production"
                id="node-breed"
                style="left:129px;top:74px;"
                onclick="buyUpgrade('breed')"
            >
                <span class="icon">🐣</span>
                Layer Breed
                <span class="cost">$450</span>
            </button>

            <button
                class="node production"
                id="node-precision"
                style="left:99px;top:234px;"
                onclick="buyUpgrade('precision')"
            >
                <span class="icon">🧪</span>
                Precision Feed
                <span class="cost">$1.6K</span>
            </button>

            <button
                class="node production"
                id="node-golden"
                style="left:204px;top:359px;"
                onclick="buyUpgrade('golden')"
            >
                <span class="icon">✨</span>
                Golden Genetics
                <span class="cost">$8K</span>
            </button>


            <!-- Marketing -->

            <button
                class="node marketing"
                id="node-sign"
                style="left:689px;top:234px;"
                onclick="buyUpgrade('sign')"
            >
                <span class="icon">🪧</span>
                Roadside Sign
                <span class="cost">$50</span>
            </button>

            <button
                class="node marketing"
                id="node-delivery"
                style="left:809px;top:154px;"
                onclick="buyUpgrade('delivery')"
            >
                <span class="icon">🚚</span>
                Local Delivery
                <span class="cost">$180</span>
            </button>

            <button
                class="node marketing"
                id="node-brand"
                style="left:939px;top:74px;"
                onclick="buyUpgrade('brand')"
            >
                <span class="icon">📣</span>
                Farm Brand
                <span class="cost">$600</span>
            </button>

            <button
                class="node marketing"
                id="node-grocery"
                style="left:964px;top:234px;"
                onclick="buyUpgrade('grocery')"
            >
                <span class="icon">🏪</span>
                Grocery Deal
                <span class="cost">$2.5K</span>
            </button>

            <button
                class="node marketing"
                id="node-national"
                style="left:864px;top:359px;"
                onclick="buyUpgrade('national')"
            >
                <span class="icon">📺</span>
                National Ads
                <span class="cost">$12K</span>
            </button>


            <!-- Automation -->

            <button
                class="node automation"
                id="node-conveyor"
                style="left:534px;top:419px;"
                onclick="buyUpgrade('conveyor')"
            >
                <span class="icon">⚙️</span>
                Conveyor
                <span class="cost">$250</span>
            </button>

            <button
                class="node automation"
                id="node-incubator"
                style="left:424px;top:514px;"
                onclick="buyUpgrade('incubator')"
            >
                <span class="icon">🔥</span>
                Incubator
                <span class="cost">$900</span>
            </button>

            <button
                class="node automation"
                id="node-brooder"
                style="left:534px;top:554px;"
                onclick="buyUpgrade('brooder')"
            >
                <span class="icon">🐥</span>
                Auto Brooder
                <span class="cost">$3.5K</span>
            </button>

            <button
                class="node automation"
                id="node-manager"
                style="left:644px;top:514px;"
                onclick="buyUpgrade('manager')"
            >
                <span class="icon">👨‍🌾</span>
                Farm Manager
                <span class="cost">$6K</span>
            </button>

            <button
                class="node automation"
                id="node-robotics"
                style="left:754px;top:454px;"
                onclick="buyUpgrade('robotics')"
            >
                <span class="icon">🤖</span>
                Robotics
                <span class="cost">$15K</span>
            </button>

        </div>

    </div>


    <div class="bottomPanels">

        <div class="card">

            <h2>📜 Farm Activity</h2>

            <div
                class="log"
                id="gameLog"
            ></div>

        </div>


        <div class="card">

            <h2>How the Economy Works</h2>

            <div class="rules">

                A chicken normally lays
                <strong>1 egg every 12 seconds</strong>.

                <br><br>

                You choose your selling price between
                <strong>$0.01 and $0.99 per egg</strong>.

                <br><br>

                Raising prices lowers public interest.
                Lower interest means eggs sell more slowly.

                <br><br>

                Farm level requirements only require you to
                <strong>own enough chickens</strong>.
                Upgrading never removes chickens.

            </div>

            <div class="saveButtons">

                <button
                    class="smallBtn"
                    onclick="saveGame(true)"
                >
                    Save Game
                </button>

                <button
                    class="smallBtn resetBtn"
                    onclick="resetGame()"
                >
                    Reset Game
                </button>

            </div>

        </div>

    </div>

</div>


<div class="tooltip" id="tooltip">

    <strong id="tooltipTitle"></strong>

    <div
        class="toolDesc"
        id="tooltipDescription"
    ></div>

    <div
        class="toolReq"
        id="tooltipRequirement"
    ></div>

</div>


<script>
const FARM_LEVELS = [

    {
        level:1,
        name:"Backyard Coop",
        chickens:0,
        cost:0,
        description:"A tiny backyard operation with big ambitions."
    },

    {
        level:2,
        name:"Family Coop",
        chickens:10,
        cost:25,
        description:"Your flock is becoming a real little business."
    },

    {
        level:3,
        name:"Homestead Farm",
        chickens:25,
        cost:100,
        description:"A proper homestead with room to grow."
    },

    {
        level:4,
        name:"Small Egg Farm",
        chickens:50,
        cost:350,
        description:"Customers around town know your eggs."
    },

    {
        level:5,
        name:"Commercial Farm",
