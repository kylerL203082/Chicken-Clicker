function updateUpgradeTree(){

    Object.keys(
        UPGRADES
    ).forEach(
        id => {

            const upgrade =
                UPGRADES[id];


            const node =
                document.getElementById(
                    "node-" +
                    id
                );


            if(!node)
                return;


            node.classList.remove(
                "available",
                "bought",
                "locked"
            );


            if(
                hasUpgrade(id)
            ){

                node.classList.add(
                    "bought"
                );

            }
            else if(
                state.farmLevel >=
                upgrade.level
                &&
                (
                    !upgrade.requires
                    ||
                    hasUpgrade(
                        upgrade.requires
                    )
                )
            ){

                node.classList.add(
                    "available"
                );

            }
            else{

                node.classList.add(
                    "locked"
                );

            }

        }
    );


    const lines = [

        ["center-feed","feed"],
        ["feed-nest","nest"],
        ["nest-breed","breed"],
        ["breed-precision","precision"],
        ["precision-golden","golden"],

        ["center-sign","sign"],
        ["sign-delivery","delivery"],
        ["delivery-brand","brand"],
        ["brand-grocery","grocery"],
        ["grocery-national","national"],

        ["center-conveyor","conveyor"],
        ["conveyor-incubator","incubator"],
        ["incubator-brooder","brooder"],
        ["brooder-manager","manager"],
        ["manager-robotics","robotics"]

    ];


    lines.forEach(
        pair => {

            const line =
                document.getElementById(
                    "line-" +
                    pair[0]
                );


            if(!line)
                return;


            if(
                hasUpgrade(
                    pair[1]
                )
            ){

                line.classList.add(
                    "active"
                );

            }
            else{

                line.classList.remove(
                    "active"
                );

            }

        }
    );

}


function setupTooltips(){

    const tooltip =
        document.getElementById(
            "tooltip"
        );


    Object.keys(
        UPGRADES
    ).forEach(
        id => {

            const node =
                document.getElementById(
                    "node-" +
                    id
                );


            const upgrade =
                UPGRADES[id];


            if(!node)
                return;


            node.addEventListener(
                "mouseenter",
                event => {

                    document.getElementById(
                        "tooltipTitle"
                    ).textContent =
                        upgrade.name;


                    document.getElementById(
                        "tooltipDescription"
                    ).textContent =
                        upgrade.description;


                    let requirement =
                        "Cost: " +
                        formatMoney(
                            upgrade.cost
                        ) +
                        " | Farm Level " +
                        upgrade.level;


                    if(
                        upgrade.requires
                    ){

                        requirement +=
                            " | Requires " +
                            UPGRADES[
                                upgrade.requires
                            ].name;

                    }


                    if(
                        hasUpgrade(id)
                    ){

                        requirement =
                            "PURCHASED";

                    }


                    document.getElementById(
                        "tooltipRequirement"
                    ).textContent =
                        requirement;


                    tooltip.style.opacity =
                        1;

                }
            );


            node.addEventListener(
                "mousemove",
                event => {

                    tooltip.style.left =
                        (
                            event.clientX +
                            18
                        ) +
                        "px";


                    tooltip.style.top =
                        (
                            event.clientY +
                            18
                        ) +
                        "px";

                }
            );


            node.addEventListener(
                "mouseleave",
                () => {

                    tooltip.style.opacity =
                        0;

                }
            );

        }
    );

}


function saveGame(manual = false){

    const saveState = {
        ...state,
        lastUpdate:Date.now()
    };


    localStorage.setItem(
        "chickenFarmEmpireSave",
        JSON.stringify(
            saveState
        )
    );


    if(manual){

        addLog(
            "Game saved."
        );

    }

}


function loadGame(){

    const saved =
        localStorage.getItem(
            "chickenFarmEmpireSave"
        );


    if(!saved){

        addLog(
            "Welcome to Chicken Farm Empire!"
        );

        return;

    }


    try{

        const parsed =
            JSON.parse(
                saved
            );


        state = {
            ...state,
            ...parsed,
            upgrades:{
                ...parsed.upgrades
            },
            lastUpdate:Date.now(),
            lastAutoChicken:
                parsed.lastAutoChicken ||
                Date.now()
        };


        addLog(
            "Saved farm loaded."
        );

    }
    catch(error){

        console.error(
            "Save could not be loaded:",
            error
        );

    }

}


function resetGame(){

    const confirmed =
        confirm(
            "Reset your entire chicken farm? This cannot be undone."
        );


    if(!confirmed)
        return;


    localStorage.removeItem(
        "chickenFarmEmpireSave"
    );


    location.reload();

}


/*
    START GAME
*/

loadGame();

setupTooltips();

updateUI();


setInterval(
    gameTick,
    100
);


setInterval(
    () => saveGame(false),
    2000
);

</script>

